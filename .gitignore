TestRoms/*
!TestRoms/.gitkeep
movies/
!movies/
movies/*
!movies/.gitkeep

# Local emulator/reference-emulator state
cfg/
nvram/
snap/

# Local reference audio. Do not commit copyrighted recordings.
*.flac
*.mp3
*.ogg

# Local BIOS/coproc blobs and cartridge images. Keep these out unless a file is
# explicitly redistributable and intentionally unignored.
Sega 32X BIOS/
Sega CD BIOS/
Sega Mega CD BIOS Set v1/
svp.bin
*BIOS*.BIN
*bios*.bin
*.cue
*.iso
*.chd
*.smd
*.gen
*.rom
*.32x
*.sms
*.gg

# Runtime state
*.srm
*.sav
*.eep
*.mdss

# Input movies may contain ROM hashes and SRAM snapshots. Keep local unless
# intentionally adding a regression asset.
*.mdmovie
!docs/assets/input-movies/
!docs/assets/input-movies/*.mdmovie
!docs/assets/input-movies/*.mdcheckpoints.json
